{
  "name": "kashcrop-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/prepare-portfolio.cjs && react-router build",
    "dev": "react-router dev",
    "deploy": "npm run build && wrangler pages deploy ./build/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "preview": "react-router-serve ./build/server/index.js",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run build",
    "preview:cloudflare": "wrangler pages dev ./build/client --port 8788"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-router/serve": "^7.18.4",
    "gsap": "^3.12.5",
    "isbot": "^5.1.17",
    "lenis": "^1.1.18",
    "mermaid": "^11.16.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^7.18.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/three": "^0.186.0",
    "axe-core": "^4.13.0",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
